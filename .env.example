# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Simulated database latency (ms) for a cache miss
DB_DELAY_MS=200

# Async queue: max concurrent simulated DB fetches
QUEUE_CONCURRENCY=4

# LRU cache
CACHE_TTL_MS=60000          # entries expire after 60s
CACHE_MAX_ENTRIES=1000      # max items before LRU eviction
CACHE_SWEEP_INTERVAL_MS=10000  # background sweep cadence for stale entries

# Rate limiting (two windows enforced together)
RATE_LIMIT_WINDOW_MS=60000  # sustained window
RATE_LIMIT_MAX=10           # max requests in the sustained window
RATE_LIMIT_BURST_WINDOW_MS=10000  # burst window
RATE_LIMIT_BURST_MAX=5      # max requests in the burst window
